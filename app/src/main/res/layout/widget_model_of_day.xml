<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="12dp"
    android:background="#0D0D0F">

    <TextView
        android:id="@+id/widget_domain"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="9sp"
        android:textColor="#6B6B72"
        android:letterSpacing="0.1"
        android:text="DECISION MAKING" />

    <TextView
        android:id="@+id/widget_model_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:textSize="15sp"
        android:textColor="#F7F5F0"
        android:text="Inversion" />

    <TextView
        android:id="@+id/widget_short_desc"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:textSize="11sp"
        android:textColor="#6B6B72"
        android:maxLines="2"
        android:text="Think backwards to find what to avoid" />

</LinearLayout>
