# Copy this to .env and fill in real values (never commit .env)

# --- Anthropic ---
ANTHROPIC_API_KEY=sk-ant-...

# --- Firebase (local dev) ---
# Option A: point to a service account file
GOOGLE_APPLICATION_CREDENTIALS=./service-account.json
FIREBASE_PROJECT_ID=bernardvb-prod

# --- Firebase (production / Render / Railway) ---
# Option B: base64-encoded service account JSON (replaces the file)
#   Generate: base64 -i service-account.json | tr -d '\n'
# FIREBASE_SERVICE_ACCOUNT_B64=eyJ0eXBlIj...

# --- App ---
PORT=3000
NODE_ENV=development
FREE_TIER_MONTHLY_LIMIT=5
